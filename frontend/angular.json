          "configurations": {
            "production": { "buildTarget": "remote-conversion:_esbuild:production" },
            "development": { "buildTarget": "remote-conversion:_esbuild:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    },

    "remote-observability": {
