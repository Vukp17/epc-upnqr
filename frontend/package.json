{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve shell",
    "start:conversion": "ng serve remote-conversion",
    "start:observability": "ng serve remote-observability",
    "start:mobile": "ng serve remote-mobile",
    "start:all": "concurrently -n shell,conversion,observability,mobile -c cyan,green,yellow,magenta \"npm run start:conversion\" \"npm run start:observability\" \"npm run start:mobile\" \"npm run start\"",
    "build": "ng build shell",
    "build:all": "ng build shell && ng build remote-conversion && ng build remote-observability && ng build remote-mobile",
    "watch": "ng build shell --watch --configuration development",
    "test": "ng test shell"
  },
  "dependencies": {
    "@angular-architects/native-federation": "^21.2.3",
    "@angular/animations": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.5",
    "@angular/cli": "^21.2.5",
    "@angular/compiler-cli": "^21.2.0",
    "concurrently": "^9.0.0",
    "es-module-shims": "^2.8.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
